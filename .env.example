# Copia in .env (lo script `npm run dev` lo fa da solo se manca). Mai segreti reali qui.

# Porte fisse, una per pezzo
WEB_PORT=3000
API_PORT=4000
# postgres 54320 e redis 63790 sono mappati in docker-compose.yml

DATABASE_URL=postgres://sdi:sdi_dev_only@localhost:54320/sdi_channel
REDIS_URL=redis://localhost:63790

# Ambiente SdI attivo: demo | production (le due configurazioni non si mescolano)
SDI_ENV=demo
# Endpoint dalle Specifiche Tecniche SdI su fatturapa.gov.it
SDI_DEMO_TRASMISSIONE_URL=
SDI_DEMO_RICEZIONE_BASE_URL=
SDI_PROD_TRASMISSIONE_URL=
SDI_PROD_RICEZIONE_BASE_URL=

# Segreti e certificati: vault/secret manager, mai nel repo
# VAULT_ADDR=
# VAULT_TOKEN=

LOG_LEVEL=info
